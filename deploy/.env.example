# Copier en .env (non versionné) et ajuster si besoin.

# --- PostgreSQL ---
POSTGRES_DB=datashare
POSTGRES_USER=datashare
POSTGRES_PASSWORD=datashare
POSTGRES_PORT=5432

# --- MinIO (stockage S3) ---
MINIO_ROOT_USER=datashare
MINIO_ROOT_PASSWORD=datashare-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DATASHARE_STORAGE_BUCKET=datashare-files

# --- Adminer ---
ADMINER_PORT=8081
