{
  "name": "datashare-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:unit": "ng test --configuration unit --watch=false",
    "test:integ": "ng test --configuration integ --watch=false",
    "test:cov": "ng test --watch=false && node tools/check-coverage.mjs",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "lint": "ng lint",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/check-config.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "cypress": "^16.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.12",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "^4.1.11"
  }
}
